# ════════════════════════════════════════════════
#   AFK Selfbot — Konfigurasi
# ════════════════════════════════════════════════

# ─── WAJIB ──────────────────────────────────────
DISCORD_TOKEN=your_user_token_here

# ─── OPSIONAL ───────────────────────────────────

# Voice channel ID untuk auto-join saat startup
# VOICE_CHANNEL_ID=123456789012345678

# Owner Discord User ID (bisa lebih dari satu, pisahkan dengan koma)
# OWNER_IDS=123456789012345678,987654321098765432

# Delay reconnect voice channel dalam milidetik (default: 5000)
# RECONNECT_DELAY_MS=5000

# Level log: DEBUG, INFO, WARN, ERROR (default: INFO)
# LOG_LEVEL=INFO

# ─── ACTIVITY / RICH PRESENCE ───────────────────

# Nama game yang ditampilkan (default: Grand Theft Auto VI)
# ACTIVITY_NAME=Grand Theft Auto VI

# RPC App ID di Discord Developer Portal.
# Default: 1445160676522856458 = Grand Theft Auto VI (game resmi di games DB Discord).
# Dengan ini, klik cover art RPC di profil membuka halaman game GTA VI di Discord.
# Isi dengan App ID aplikasi portal milikmu sendiri kalau mau custom (misal: "gta6" asset),
# tapi klik cover art tidak akan membuka halaman game.
# RPC_APP_ID=1445160676522856458

# Logo gambar besar. Pilihan:
#   (kosong/komentar) → pakai cover GTA VI dari CDN Discord (default)
#   https://cdn.discordapp.com/app-icons/1445160676522856458/0788ab1237f5801d9f72af6d34665327.png  → cover GTA VI (default, eksplisit)
#   gta6        → asset bernama "gta6" di Art Assets aplikasi RPC_APP_ID (hanya kalau RPC_APP_ID aplikasi milikmu)
#   <id>        → Snowflake ID asset dari Art Assets
#   https://... → URL publik (dikonversi otomatis ke mp:external)
#   none        → tanpa logo
# ACTIVITY_LARGE_IMAGE=https://cdn.discordapp.com/app-icons/1445160676522856458/0788ab1237f5801d9f72af6d34665327.png

# Hover tooltip saat kursor di atas logo (opsional)
# ACTIVITY_LARGE_TEXT=

# Teks baris kedua di bawah judul (kosongkan agar tidak muncul)
# ACTIVITY_DETAILS=

# ─── VOICE STATE ────────────────────────────────

# Status akun saat join voice channel
# VOICE_SELF_MUTE=true
# VOICE_SELF_DEAF=true
